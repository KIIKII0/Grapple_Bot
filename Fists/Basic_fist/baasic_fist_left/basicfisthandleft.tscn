[sub_resource type="GDScript" id="GDScript_fxrht"]
script/source = "extends Node3D


var grappling = false
var hookpoint = Vector3()
var hookpoint_get = false

@onready var crosshair = $crosshair
@onready var grapple_reach = $grapple_reach
@onready var parent_hand = get_parent().get_name()
@onready var rope_start = $\".\"
@onready var character = get_tree().get_nodes_in_group(\"Player\")[0]
@onready var rope = $rope
@onready var pull_speed = Globvar.pull_speed

	
func _physics_process(delta):
	#function to display crosshai in place when the raycast collide and dont show him when the character is grappling
	if grapple_reach.is_colliding() and not grappling:
		#function that makes crosshair look at object and appear
		var crosshair_position = grapple_reach.get_collision_point() * 0.998
		crosshair.global_transform.origin = crosshair_position + grapple_reach.get_collision_normal() * 0.3
		var direction = crosshair_position - crosshair.global_transform.origin
		if not Vector3.UP.cross(direction).is_zero_approx():
			crosshair.look_at(crosshair_position, Vector3.UP)
		else:
			pass
		crosshair.visible = true
	elif  grapple_reach.is_colliding() == false:
		crosshair.visible = false
		
	#function to actualy grapple
	if Input.is_action_just_pressed(\"attack_left\") and parent_hand == \"left_arm\":
		if grapple_reach.is_colliding() and not grappling:
			grappling = true
	if grappling:
		if not hookpoint_get:
			hookpoint = grapple_reach.get_collision_point()
			hookpoint_get = true
		if hookpoint.distance_to(character.transform.origin) > 3:
			var hook_direction = hookpoint - character.transform.origin
			if hookpoint_get:
				rope_update()
				character.velocity += hook_direction * pull_speed * delta
		else:
			grappling = false
			hookpoint_get = false
			rope.visible = false
	#function to cancel grapple when not golding a button
	if Input.is_action_just_released(\"attack_left\") and parent_hand == \"left_arm\":
		grappling = false
		hookpoint_get = false
		rope.visible = false
#function to update rope and its position
func rope_update():
		rope.visible = true
		var distance_rope = hookpoint.distance_to(rope_start.global_transform.origin)
		rope.scale.y = 2
		rope.scale.z = distance_rope / 2.05
		var midpoint = (hookpoint + rope_start.global_transform.origin) / 2
		rope.global_transform.origin = midpoint
		rope.look_at(hookpoint,Vector3.UP)
		rope.rotate_object_local(Vector3(1, 0, 0), deg_to_rad(90))
"

