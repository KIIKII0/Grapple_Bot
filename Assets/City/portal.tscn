[sub_resource type="GDScript" id="GDScript_dbvi5"]
script/source = "@tool
extends Node3D
@onready var outer_donut = $outer
@onready var inner_donut = $inner
# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	outer_donut.rotate_object_local(Vector3(0, 1, 0), deg_to_rad(Vector3(0, 30, 0).y * delta))
	inner_donut.rotate_object_local(Vector3(0, 1, 0), deg_to_rad(Vector3(0, -15, 0).y * delta))

func _on_area_3d_body_entered(body):
	if body.is_in_group(\"Player\"):
		get_parent().change()
"

